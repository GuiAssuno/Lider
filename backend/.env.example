# Banco de dados PostgreSQL
DATABASE_URL=postgresql://lider:lider@127.0.0.1:5432/lider
TEST_DATABASE_URL=postgresql://lider:lider@127.0.0.1:5432/lider_test

# Seguranca / JWT
# Gere um segredo aleatorio com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-aleatorio-seguro-antes-de-rodar
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Riot API: use "fake" em desenvolvimento local ou "real" quando tiver a chave da Riot
RIOT_MODE=fake
RIOT_API_KEY=
RIOT_TIMEOUT_SECONDS=10

# Logs
LOG_LEVEL=INFO
